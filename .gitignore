# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.venv/

# Environment & secrets
.env
.env.*
!.env.example
deploy.env

# Personal deploy scripts (host-specific — never commit)
scripts/deploy-pacman.sh
deploy.local.sh

# Telegram sessions (auth tokens)
*.session
*.session-journal
*.session-wal
*.session-shm

# Logs & runtime
logs/*
!logs/.gitkeep
*.log
tmp/*
!tmp/.gitkeep

# Temp & media working files
*.tmp
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Docker
.docker/

# OS
Thumbs.db

# ── Personal profile & voice corpus (NEVER commit) ──
data/profile.md
data/cognitive-profile.md
data/telegram-voice/my-messages.txt
data/telegram-voice/voice.compact.txt
