# Telegram API credentials — https://my.telegram.org/apps
API_ID=
API_HASH=
PHONE_NUMBER=
SESSION_NAME=selfbot

# Application
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data
TEMP_DIR=tmp

# Reactions
REACTION_COOLDOWN_SECONDS=2.0
REACTION_MAX_RETRIES=3
REACTION_FALLBACK_EMOJIS=👍,🔥,❤️,😂,🎉

# Media processing
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=120
STICKER_MAX_DIMENSION=512
GIF_MAX_WIDTH=480
GIF_FPS=15

# Text stream (.stream)
STREAM_EDIT_DELAY_SECONDS=0.5
STREAM_EDIT_MAX_RETRIES=3

# Video note (.vmsg)
VIDEO_NOTE_SIZE=640
VIDEO_NOTE_FPS=30

# Voice message (.tovoice)
VOICE_BITRATE_KBPS=64

# Awk (.awk)
AWK_PATH=awk
AWK_TIMEOUT_SECONDS=30
AWK_MAX_OUTPUT_CHARS=3800
