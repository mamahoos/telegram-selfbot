# Telegram API credentials — https://my.telegram.org/apps
API_ID=
API_HASH=
PHONE_NUMBER=
SESSION_NAME=selfbot

# Application
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data
TEMP_DIR=tmp

# Reactions
REACTION_COOLDOWN_SECONDS=2.0
REACTION_MAX_RETRIES=3
REACTION_FALLBACK_EMOJIS=👍,🔥,❤️,😂,🎉

# Media processing
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=120
STICKER_MAX_DIMENSION=512
GIF_MAX_WIDTH=480
GIF_FPS=15
